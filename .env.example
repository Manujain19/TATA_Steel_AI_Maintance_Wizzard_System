# Maintenance Wizard runtime configuration

# Startup warms AI models before marking the system ready.
EAGER_LOAD_AI_MODELS=false
ENABLE_RUNTIME_MODEL_LOADING=true
AUTO_INDEX_VECTOR_STORE=false
BACKGROUND_PRELOAD=true
BACKGROUND_PRELOAD_AI_MODELS=true

# MODEL_MODE=offline uses only local model files.
# MODEL_MODE=download_if_missing allows one-time Hugging Face download and persists under MODEL_CACHE_DIR.
MODEL_MODE=offline
MODEL_CACHE_DIR=.model_cache
ALLOW_MODEL_FALLBACK=false

# Supported: sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-large-en-v1.5, nomic-embed-text
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cross-encoder reranker used when sentence-transformers is installed.
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Supported: chromadb, qdrant
VECTOR_DB=chromadb
CHROMA_PATH=.vectorstores/chromadb
QDRANT_URL=http://localhost:6333

# Llama 3.3 70B through Groq.
LLM_PROVIDER=groq
LLAMA_BASE_URL=https://api.groq.com/openai/v1
LLAMA_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=
LLM_FAIL_FAST=false

# Optional observability.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=maintenance-wizard

# Optional PostgreSQL mode. JSON seed mode is used when false.
ENABLE_POSTGRES=false
DATABASE_URL=postgresql://maintenance:maintenance@localhost:5432/maintenance_wizard
